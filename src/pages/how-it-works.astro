---
import Base from '../layouts/Base.astro';
import DataTable from '../components/DataTable.astro';
import { how, roadEvents } from '../lib/data';
import { url } from '../lib/url';
---
<Base title={how.seo_title} description={how.seo_description}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">How it works</span>
      <h1>{how.title}</h1>
      <p>{how.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <ol class="steps">
        {how.steps.map((s) => (
          <li><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  {how.vault_title && (
    <section class="section section--tight vault-sec">
      <div class="container narrow">
        <div class="vault-callout">
          <div class="vault-callout__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
          </div>
          <div>
            <h2>{how.vault_title}</h2>
            <p>{how.vault_text}</p>
            {how.vault_link && <a class="btn btn--ghost" href={url(how.vault_link)}>{how.vault_link_text || 'Learn more'}</a>}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section section--surface">
    <div class="container">
      <h2>{how.levels_title}</h2>
      <div class="table-wrap">
        <table>
          <caption class="sr-only">{how.levels_title}</caption>
          <thead><tr><th scope="col" class="num">Level</th><th scope="col">Name</th><th scope="col">What a buyer receives</th><th scope="col">Default</th></tr></thead>
          <tbody>
            {how.levels.map((l) => (
              <tr><td class="num">{l.level}</td><td>{l.name}</td><td class="wrap">{l.receives}</td><td><span class="pill">{l.default}</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--night">
    <div class="container narrow">
      <h2>{how.privacy_title}</h2>
      <ul class="checklist">
        {how.privacy.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="events">
    <div class="container">
      <h2>{how.events_title}</h2>
      <p class="lead">{how.events_text}</p>
      <DataTable
        id="all-events"
        caption="All road events in the demo dataset"
        columns={[
          { key: 'event_id', label: 'Event' },
          { key: 'event_type', label: 'Type' },
          { key: 'confidence', label: 'Confidence', num: true, format: 'fixed2' },
          { key: 'latitude', label: 'Latitude', num: true, format: 'fixed4' },
          { key: 'longitude', label: 'Longitude', num: true, format: 'fixed4' },
          { key: 'detected_at', label: 'Detected' },
        ]}
        rows={roadEvents.events}
      />
      <p class="muted">As of {roadEvents.as_of}. {roadEvents.note}</p>
    </div>
  </section>
</Base>
<style>
  .narrow { max-width: 820px; }
  .section--night .checklist { color: var(--color-on-night); }
  .vault-sec { padding-top: 0; }
  .vault-callout { display: grid; grid-template-columns: 64px 1fr; gap: var(--space-6); align-items: start; padding: var(--space-8); border-radius: var(--radius-card); background: var(--color-amber-tint); border: 1px solid #f3d9b4; border-left: 5px solid var(--color-amber); }
  .vault-callout h2 { font-size: var(--fs-h3); margin-bottom: 8px; }
  .vault-callout__icon { width: 64px; height: 64px; border-radius: 16px; background: var(--color-night); display: grid; place-items: center; }
  .vault-callout__icon svg { width: 30px; height: 30px; fill: none; stroke: var(--color-amber-light); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 560px) { .vault-callout { grid-template-columns: 1fr; } }
</style>
