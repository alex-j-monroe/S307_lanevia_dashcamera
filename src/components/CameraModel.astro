---
// Interactive low-poly 3D model of RoadSense One (three.js). Drag to rotate.
interface Props { label?: string }
const { label = 'Interactive low-poly 3D model of the RoadSense One dash camera: charcoal faceted body, amber lens ring, windshield ball-joint mount and a rear privacy status screen.' } = Astro.props;
---
<div class="model">
  <div class="model__stage" data-cam3d role="img" aria-label={label}></div>
  <div class="model__bar" role="toolbar" aria-label="3D view controls">
    <button type="button" data-view="hero">3/4</button>
    <button type="button" data-view="front">Front</button>
    <button type="button" data-view="side">Side</button>
    <button type="button" data-view="rear">Rear</button>
    <button type="button" data-spin aria-pressed="true">Rotate</button>
  </div>
  <p class="model__hint">Drag to rotate</p>
</div>
<style>
  .model { position: relative; aspect-ratio: 1 / 0.9; width: 100%; border-radius: 24px; overflow: hidden;
    background: radial-gradient(ellipse at 55% 35%, #fbfaf7 0%, #ece9e2 55%, #dcd6cb 100%); border: 1px solid var(--color-border); }
  .model__stage { position: absolute; inset: 0; }
  .model__stage :global(canvas) { display: block; width: 100%; height: 100%; cursor: grab; touch-action: none; }
  .model__bar { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; gap: 4px;
    background: rgba(255,255,255,.88); border: 1px solid var(--color-border); border-radius: 999px; padding: 4px; }
  .model__bar button { font: inherit; font-size: 13px; font-weight: 600; border: 0; background: transparent; color: var(--color-ink);
    padding: 6px 12px; border-radius: 999px; cursor: pointer; }
  .model__bar button:hover { background: var(--color-surface); }
  .model__bar button[aria-pressed="true"] { background: var(--color-amber); }
  .model__hint { position: absolute; top: 12px; right: 16px; margin: 0; font-size: 12px; color: var(--color-muted); }
</style>
<script>
  import * as THREE from 'three';

  function mount(stage: HTMLElement) {
    if (THREE.ColorManagement) (THREE.ColorManagement as any).legacyMode = false;
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    } catch (e) {
      stage.innerHTML = '<p style="padding:24px">3D preview needs WebGL, which this browser has turned off.</p>';
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.outputEncoding = THREE.sRGBEncoding;
    stage.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);

    scene.add(new THREE.HemisphereLight(0xfff8ee, 0x8f877b, 0.75));
    const key = new THREE.DirectionalLight(0xffffff, 1.35);
    key.position.set(5, 8, 6);
    key.castShadow = true;
    key.shadow.mapSize.set(1024, 1024);
    Object.assign(key.shadow.camera, { left: -6, right: 6, top: 6, bottom: -6 });
    key.shadow.bias = -0.0005;
    scene.add(key);
    const rim = new THREE.DirectionalLight(0xffd9a3, 0.55);
    rim.position.set(-6, 3, -5);
    scene.add(rim);

  // ---------- materials (flat shading = low-poly look) ----------
    const mat = (color, opts = {}) => new THREE.MeshStandardMaterial(Object.assign({ color, flatShading: true, roughness: 0.62, metalness: 0.08 }, opts));
    const M = {
      body:   mat(0x2b2f36, { roughness: 0.55 }),
      bodyHi: mat(0x3a3f48, { roughness: 0.5 }),
      amber:  mat(0xd97706, { roughness: 0.45, metalness: 0.15 }),
      dark:   mat(0x15171b, { roughness: 0.4 }),
      glass:  mat(0x0b0d12, { roughness: 0.08, metalness: 0.6 }),
      lensIn: mat(0x1d3550, { roughness: 0.15, metalness: 0.5, emissive: 0x0b1a2a, emissiveIntensity: 0.6 }),
      rubber: mat(0x1f2125, { roughness: 0.9 }),
      led:    mat(0xf59e0b, { emissive: 0xf59e0b, emissiveIntensity: 1.4 }),
      base:   mat(0xbdb5a6, { roughness: 1 }),
      baseEdge: mat(0x9c9384, { roughness: 1 }),
    };
    const shadowy = (m) => { m.castShadow = true; m.receiveShadow = true; return m; };

    // ---------- camera model ----------
    const cam = new THREE.Group();
    scene.add(cam);

    // Body: octagonal prism lying along x
    const bodyGeo = new THREE.CylinderGeometry(1, 1, 3.0, 8, 1, false, Math.PI / 8);
    bodyGeo.rotateZ(Math.PI / 2);
    bodyGeo.scale(1, 0.62, 0.82);
    const body = shadowy(new THREE.Mesh(bodyGeo, M.body));
    cam.add(body);

    // End caps (slightly lighter, inset) for faceted depth
    [-1, 1].forEach((s) => {
      const capGeo = new THREE.CylinderGeometry(0.86, 0.86, 0.12, 8, 1, false, Math.PI / 8);
      capGeo.rotateZ(Math.PI / 2);
      capGeo.scale(1, 0.62, 0.82);
      const cap = shadowy(new THREE.Mesh(capGeo, M.bodyHi));
      cap.position.x = s * 1.53;
      cam.add(cap);
    });

    // Amber accent band across the top-front chamfer
    const band = shadowy(new THREE.Mesh(new THREE.BoxGeometry(2.6, 0.07, 0.34), M.amber));
    band.position.set(0, 0.47, 0.58);
    band.rotation.x = -Math.PI / 4;
    cam.add(band);

    // Lens assembly on the front face (+z)
    const lensX = 0.55, frontZ = 0.82;
    const housing = shadowy(new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.58, 0.34, 10), M.dark));
    housing.rotation.x = Math.PI / 2;
    housing.position.set(lensX, -0.02, frontZ + 0.15);
    cam.add(housing);
    const ring = shadowy(new THREE.Mesh(new THREE.TorusGeometry(0.44, 0.07, 5, 10), M.amber));
    ring.position.set(lensX, -0.02, frontZ + 0.33);
    cam.add(ring);
    const glass = new THREE.Mesh(new THREE.CircleGeometry(0.4, 10), M.glass);
    glass.position.set(lensX, -0.02, frontZ + 0.325);
    cam.add(glass);
    const inner = new THREE.Mesh(new THREE.CircleGeometry(0.2, 8), M.lensIn);
    inner.position.set(lensX, -0.02, frontZ + 0.33);
    cam.add(inner);
    const glint = new THREE.Mesh(new THREE.CircleGeometry(0.06, 6), new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.75 }));
    glint.position.set(lensX + 0.13, 0.11, frontZ + 0.335);
    cam.add(glint);

    // Front status LED and sensor window
    const led = new THREE.Mesh(new THREE.OctahedronGeometry(0.06, 0), M.led);
    led.position.set(-0.55, 0.12, frontZ + 0.01);
    cam.add(led);
    const sensor = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.16, 0.04), M.glass);
    sensor.position.set(-0.55, -0.14, frontZ - 0.01);
    cam.add(sensor);

    // Top cooling vents
    for (let i = 0; i < 5; i++) {
      const v = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.03, 0.5), M.dark);
      v.position.set(-1.05 + i * 0.16, 0.62, -0.18);
      cam.add(v);
    }

    // Side button (amber)
    const btn = shadowy(new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.11, 0.08, 6), M.amber));
    btn.rotation.z = Math.PI / 2;
    btn.position.set(-1.62, 0.1, 0.1);
    cam.add(btn);

    // Canvas text helper for low-poly decals
    function textTexture(lines, w, h, bg, fg, sizes) {
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const g = c.getContext('2d');
      if (bg) { g.fillStyle = bg; g.fillRect(0, 0, w, h); }
      g.textAlign = 'center'; g.textBaseline = 'middle';
      lines.forEach((t, i) => {
        g.fillStyle = Array.isArray(fg) ? fg[i] : fg;
        g.font = '700 ' + sizes[i] + 'px system-ui, Segoe UI, Arial, sans-serif';
        g.fillText(t, w / 2, h * (lines.length === 1 ? 0.5 : (i + 1) / (lines.length + 1)));
      });
      const tex = new THREE.CanvasTexture(c);
      tex.encoding = THREE.sRGBEncoding;
      tex.anisotropy = 4;
      return tex;
    }

    // Logo on the right end cap (+x)
    const logo = new THREE.Mesh(new THREE.PlaneGeometry(1.0, 0.3),
      new THREE.MeshBasicMaterial({ map: textTexture(['LANEVIA'], 512, 154, null, '#d97706', [92]), transparent: true }));
    logo.rotation.y = Math.PI / 2;
    logo.position.set(1.6, 0, 0);
    cam.add(logo);

    // Rear privacy status screen (-z)
    const bezel = shadowy(new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.66, 0.06), M.dark));
    bezel.position.set(0, 0, -0.83);
    cam.add(bezel);
    const screen = new THREE.Mesh(new THREE.PlaneGeometry(1.36, 0.54),
      new THREE.MeshBasicMaterial({ map: textTexture(['AUDIO OFF', 'BLUR ON  ·  3 BUYERS'], 680, 270, '#101318', ['#f59e0b', '#c9ced6'], [74, 44]) }));
    screen.rotation.y = Math.PI;
    screen.position.set(0, 0, -0.865);
    cam.add(screen);

    // Mount: ball joint, stem, adhesive pad
    const ball = shadowy(new THREE.Mesh(new THREE.IcosahedronGeometry(0.24, 0), M.bodyHi));
    ball.position.set(-0.1, 0.78, -0.05);
    cam.add(ball);
    const stem = shadowy(new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.19, 0.55, 6), M.body));
    stem.position.set(-0.1, 1.15, -0.05);
    cam.add(stem);
    const pad = shadowy(new THREE.Mesh(new THREE.CylinderGeometry(0.62, 0.62, 0.1, 6), M.rubber));
    pad.scale.set(1.5, 1, 1);
    pad.position.set(-0.1, 1.47, -0.05);
    cam.add(pad);
    const padTrim = shadowy(new THREE.Mesh(new THREE.CylinderGeometry(0.66, 0.66, 0.04, 6), M.amber));
    padTrim.scale.set(1.5, 1, 1);
    padTrim.position.set(-0.1, 1.535, -0.05);
    cam.add(padTrim);

    cam.position.y = 0.2;


    // Pedestal
    const top = new THREE.Mesh(new THREE.CylinderGeometry(2.7, 2.9, 0.28, 6), M.base);
    top.receiveShadow = true; top.position.y = -1.55; scene.add(top);
    const lip = new THREE.Mesh(new THREE.CylinderGeometry(2.95, 3.15, 0.22, 6), M.baseEdge);
    lip.receiveShadow = true; lip.position.y = -1.79; scene.add(lip);
    const cone = (x: number, z: number, s: number) => {
      const c = shadowy(new THREE.Mesh(new THREE.ConeGeometry(0.16 * s, 0.42 * s, 5), M.amber));
      c.position.set(x, -1.39 + 0.21 * s, z);
      const b = shadowy(new THREE.Mesh(new THREE.BoxGeometry(0.34 * s, 0.05 * s, 0.34 * s), M.dark));
      b.position.set(x, -1.39, z);
      scene.add(c, b);
    };
    cone(1.9, 0.8, 1); cone(2.2, 0.1, 0.8); cone(-2.0, 1.0, 0.9);

    const root = stage.parentElement!;
    const views: Record<string, { yaw: number; pitch: number }> = {
      hero: { yaw: -0.65, pitch: 0.18 }, front: { yaw: 0, pitch: 0.05 },
      side: { yaw: -1.5708, pitch: 0.08 }, rear: { yaw: 3.1416, pitch: 0.1 },
    };
    let yaw = views.hero.yaw, pitch = views.hero.pitch;
    const target = { yaw, pitch };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let spinning = !reduce;
    const spinBtn = root.querySelector<HTMLButtonElement>('[data-spin]')!;
    const setSpin = (on: boolean) => { spinning = on; spinBtn.setAttribute('aria-pressed', String(on)); };
    setSpin(spinning);
    spinBtn.addEventListener('click', () => setSpin(!spinning));
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
      setSpin(false);
      const v = views[b.dataset.view!];
      let ty = v.yaw;
      while (ty - yaw > Math.PI) ty -= Math.PI * 2;
      while (ty - yaw < -Math.PI) ty += Math.PI * 2;
      target.yaw = ty; target.pitch = v.pitch;
    }));

    const canvas = renderer.domElement;
    let drag: { x: number; y: number; yaw: number; pitch: number } | null = null;
    canvas.addEventListener('pointerdown', (e) => {
      drag = { x: e.clientX, y: e.clientY, yaw, pitch };
      canvas.setPointerCapture(e.pointerId); setSpin(false);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!drag) return;
      yaw = target.yaw = drag.yaw + (e.clientX - drag.x) * 0.01;
      pitch = target.pitch = Math.max(-0.5, Math.min(0.9, drag.pitch + (e.clientY - drag.y) * 0.006));
    });
    const end = () => { drag = null; };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    const resize = () => {
      const w = stage.clientWidth, h = stage.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h; camera.updateProjectionMatrix();
    };
    new ResizeObserver(resize).observe(stage);
    resize();

    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(stage);

    const clock = new THREE.Clock();
    const frame = () => {
      requestAnimationFrame(frame);
      const dt = Math.min(clock.getDelta(), 0.05);
      if (!visible) return;
      if (spinning) target.yaw += dt * 0.35;
      yaw += (target.yaw - yaw) * Math.min(1, dt * (spinning ? 20 : 6));
      pitch += (target.pitch - pitch) * Math.min(1, dt * 6);
      cam.rotation.set(pitch, yaw, 0, 'YXZ');
      const dist = camera.aspect < 0.9 ? 13.5 : 11.5;
      camera.position.set(0, 1.4, dist);
      camera.lookAt(0, 0.1, 0);
      led.material.emissiveIntensity = 1.1 + Math.sin(clock.elapsedTime * 3) * 0.4;
      renderer.render(scene, camera);
    };
    frame();
  }

  document.querySelectorAll<HTMLElement>('[data-cam3d]').forEach(mount);
</script>
